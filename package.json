{
  "name": "evalos",
  "version": "0.1.0",
  "description": "Turn agent failures into regression tests. npm run demo → fail → Confirm → CI red.",
  "private": false,
  "license": "Apache-2.0",
  "author": "Rikin Shah",
  "homepage": "https://github.com/rikinshah787/evalos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikinshah787/evalos.git"
  },
  "bugs": {
    "url": "https://github.com/rikinshah787/evalos/issues"
  },
  "keywords": [
    "cursor",
    "cursor-hooks",
    "claude-code",
    "claude-code-hooks",
    "agent-evals",
    "agent-evaluation",
    "ai-agents",
    "ai-agent-testing",
    "opentelemetry",
    "evals",
    "llm-evals",
    "llmops",
    "jev",
    "observability",
    "regression-testing",
    "promptfoo",
    "pytest"
  ],
  "bin": {
    "evalos": "./bin/evalos.mjs",
    "evalos-mcp": "./bin/evalos-mcp.mjs"
  },
  "files": [
    "app",
    "bin",
    "components",
    "fixtures",
    "evals",
    ".claude",
    ".cursor",
    ".env.example",
    "CONTRIBUTING.md",
    "db",
    "docs",
    "lib",
    "LICENSE",
    "scripts",
    "README.md",
    "drizzle.config.ts",
    "next.config.ts",
    "tsconfig.json",
    "eslint.config.mjs"
  ],
  "scripts": {
    "dev": "node scripts/ensure-cursor-setup.mjs && next dev",
    "build": "next build",
    "start": "node scripts/ensure-cursor-setup.mjs && next start",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint app lib scripts tests next.config.ts drizzle.config.ts eslint.config.mjs vitest.config.mts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "gate": "node scripts/ci-gate.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "0.544.0",
    "next": "^16.3.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.5.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.35.0",
    "eslint-config-next": "^16.3.5",
    "typescript": "5.9.2",
    "vitest": "^5.0.1"
  }
}
